# Neon Postgres connection string.
# Do not paste a real value here - this file is committed.
# Vercel's Neon integration sets DATABASE_URL for you; pull it with:
#   npx vercel env pull .env.local
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# PIN for the gate on the whole app. Defaults to 111111 when unset.
ACCESS_PIN=111111
